<?xml version="1.0" encoding="utf-8"?>
<!--
  psToDo - IIS access control for the HTML dashboard
  ==================================================
  Put this file in the SAME folder as index.html (the folder the IIS site/application
  points to). By default that is Files\report. The report scripts never overwrite it.

  Who can see the page: ONLY members of the AD security group psToDo-Viewers.
  Everyone else, including anonymous users and every other domain user, gets HTTP 401.

  BEFORE USE: replace DOMAIN with your NetBIOS domain name (e.g. CONTOSO\psToDo-Viewers).
  Install-help\Setup-IisReportSecurity.ps1 writes this file for you: it looks the group
  up in AD and fills in the correct DOMAIN\ prefix. To let a group edit the data in the
  browser (edit.html), run Install-help\Setup-IisReportEditor.ps1 afterwards: it adds the
  editors group, allows .ashx and writes the appSettings the save handler reads.

  Requirements on the IIS server (the setup script installs/configures these):
    - Windows Authentication   (Web-Windows-Auth)
    - URL Authorization        (Web-Url-Auth)
    - Windows Authentication ENABLED and Anonymous Authentication DISABLED for the site.
      Those two settings are locked at server level, so they are set in IIS Manager or by
      the setup script, not in this file (putting them here gives HTTP 500.19).

  Why system.webServer/security/authorization and not system.web/authorization:
  index.html is a static file. system.web rules only apply to ASP.NET requests, so they
  would NOT protect it. IIS URL Authorization applies to every request, static files included.
-->
<configuration>
  <system.webServer>

    <security>
      <authorization>
        <!-- Drop anything inherited from the server or parent site (e.g. "Allow All Users"). -->
        <clear />
        <!-- Only psToDo-Viewers. Every other user is denied because nothing else is allowed. -->
        <add accessType="Allow" roles="DOMAIN\psToDo-Viewers" />
      </authorization>

      <!-- Only serve what the dashboard needs. -->
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".html" allowed="true" />
          <add fileExtension=".htm" allowed="true" />
          <add fileExtension=".png" allowed="true" />
          <add fileExtension=".ico" allowed="true" />
          <add fileExtension="." allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <httpProtocol>
      <customHeaders>
        <!-- The page lists internal servers and accounts: do not let browsers or proxies cache it. -->
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
