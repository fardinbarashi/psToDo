<?xml version="1.0" encoding="utf-8"?>
<!--
  psToDo - IIS access for the dashboard. Put it in the folder IIS serves (Files\report).
  Only the AD group below can open the page; everyone else gets 401.
  Install-help\Setup-IisReportSecurity.ps1 writes this file with the right DOMAIN prefix.
  Install-help\Setup-IisReportEditor.ps1 adds the editors group and the save handler settings.
  Needs Windows Authentication and URL Authorization; Anonymous off for the site.
  system.webServer authorization also protects static files (system.web does not).
-->
<configuration>
  <system.webServer>

    <security>
      <authorization>
        <!-- Remove inherited rules -->
        <clear />
        <!-- Viewers only -->
        <add accessType="Allow" roles="DOMAIN\psToDo-Viewers" />
      </authorization>

      <!-- Allowed file types -->
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".html" allowed="true" />
          <add fileExtension=".htm" allowed="true" />
          <add fileExtension=".png" allowed="true" />
          <add fileExtension=".ico" allowed="true" />
          <add fileExtension="." allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <httpProtocol>
      <customHeaders>
        <!-- No caching -->
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
